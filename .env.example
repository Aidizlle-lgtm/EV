# E.V. configuration.
# start_ev.bat copies this file to ".env" on first run. You can paste keys here, or
# (easier) in the app: Settings -> API keys. Either way they are stored ONLY in .env
# on this laptop. .env is git-ignored. E.V. never reads keys from your system
# environment variables - only from this file.

# ---------------------------------------------------------------- Server
# 127.0.0.1 = this laptop only (default). 0.0.0.0 = also your phone on the same Wi-Fi.
EV_HOST=127.0.0.1
EV_PORT=8000
# Optional HTTPS certificate (phones only allow the microphone over HTTPS):
# EV_SSL_CERTFILE=C:\path\to\cert.pem
# EV_SSL_KEYFILE=C:\path\to\key.pem

# ---------------------------------------------------------------- AI providers (add at least one)
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------------------------------------------------------------- Voice
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys  (voice ID is set in the app)
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------- Live data
# GitHub fine-grained token, read-only (used for "PRs awaiting your review")
GITHUB_TOKEN=

# ---------------------------------------------------------------- Email sending
# SMTP password. For Gmail use an App Password, not your normal password.
SMTP_PASSWORD=
